# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=

# Authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
VITE_AUTH_ENABLED=true

# Model provider
XAI_API_KEY=
ANTHROPIC_API_KEY=
# If both keys exist, Anthropic is preferred. Example: claude-sonnet-4-5-20250929
NEXO_AGENT_MODEL=

# Connector gateway
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# Server-side secret vault. Use database for Railway/Vercel; use aws only with
# an AWS task role/IRSA. Never put connector tokens in this file in production.
NEXO_SECRETS_BACKEND=database
NEXO_SECRETS_ENCRYPTION_KEY=
AWS_REGION=

# Agent Runtime worker endpoint (store the token in the deployment secret store)
NEXO_RUNTIME_WORKER_TOKEN=
NEXO_RUNTIME_MAX_BATCH=5

# Public URLs
APP_BASE_URL=http://localhost:3000
WEBHOOK_BASE_URL=

# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=

# Authentication
BETTER_AUTH_SECRET=

# Model provider
XAI_API_KEY=

# Connector gateway
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# Server-side secrets (AWS task role/IRSA supplies credentials; never put tokens here)
NEXO_SECRETS_BACKEND=unconfigured
AWS_REGION=

# Agent Runtime worker endpoint (store the token in the deployment secret store)
NEXO_RUNTIME_WORKER_TOKEN=
NEXO_RUNTIME_MAX_BATCH=5

# Public URLs
APP_BASE_URL=http://localhost:3000
WEBHOOK_BASE_URL=
